# テスト用環境変数テンプレート
# このファイルを .env.test としてコピーして、適切な値を設定してください

# Database（テスト用）
DATABASE_URL=postgresql://test_user:test_password@localhost:5433/test_lms
DATABASE_URL_FOR_DOCKER=postgresql://test_user:test_password@lms-test-db:5432/test_lms

# Better Auth
BETTER_AUTH_SECRET=test_secret_key_for_testing_purposes_only_32chars
BETTER_AUTH_URL=http://localhost:3000

# Google API（テスト用ダミー値）
GOOGLE_CLIENT_ID=test_client_id
GOOGLE_CLIENT_SECRET=test_client_secret_minimum_32_characters

# Github API（テスト用ダミー値）
GH_CLIENT_ID=test_github_client_id
GH_CLIENT_SECRET=test_github_client_secret_minimum_32_characters

# X API（テスト用ダミー値）
TWITTER_CLIENT_ID=test_twitter_client_id
TWITTER_CLIENT_SECRET=test_twitter_client_secret_minimum_32_chars

# Resend（テスト用ダミー値）
RESEND_API_KEY=re_test_api_key_minimum_32_characters_for_testing
EMAIL_ADDRESS=test@example.com

# Arcjet（テスト用ダミー値）
ARCJET_KEY=ajkey_test_key_minimum_32_characters_for_testing

# Fake-GCS（テスト用）
GCS_EMULATOR_HOST=http://localhost:8000
GCS_BUCKET_NAME=test-storage-bucket

# CORS
CORS_ORIGIN=http://localhost:3001

# 実行環境
NODE_ENV=test
