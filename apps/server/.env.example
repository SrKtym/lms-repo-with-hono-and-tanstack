# 開発用環境変数テンプレート
# このファイルを .env としてコピーして、適切な値を設定してください

# Database（ローカル）
DATABASE_URL=postgresql://username:password@localhost:5432/database_name
DATABASE_URL_FOR_DOCKER=postgresql://username:password@db:5432/database_name

# Better Auth
BETTER_AUTH_SECRET=your_secret_key_minimum_32_characters
BETTER_AUTH_URL=http://localhost:3000

# Google API
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret_minimum_32_characters

# Github API
GH_CLIENT_ID=your_github_client_id
GH_CLIENT_SECRET=your_github_client_secret_minimum_32_characters

# X API
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret_minimum_32_characters

# Resend
RESEND_API_KEY=your_resend_api_key_minimum_32_characters
EMAIL_ADDRESS=your_email@example.com

# Arcjet
ARCJET_KEY=your_arcjet_key_minimum_32_characters

# Fake-GCS（Google Cloud Storageのエミュレーター)
GCS_EMULATOR_HOST=http://fake-gcs:8000
GCS_BUCKET_NAME=your_storage_bucket_name

# CORS
CORS_ORIGIN=http://localhost:3001

# 実行環境
NODE_ENV=development
